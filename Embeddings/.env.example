# Copy to .env and adjust. config.py loads this automatically for host scripts.

# --- Postgres / pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=echr
POSTGRES_USER=echr
POSTGRES_PASSWORD=echr

# --- Embedding vLLM server ---
EMBED_BASE_URL=http://localhost:8100/v1
EMBED_PORT=8100
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
ACTIVE_MODEL=qwen3-emb-8b

# --- Retrieval / scoring ---
TOP_K=10
# PREDICTION_MIN_SCORE=0.4   # optional cosine-similarity threshold; unset = take all top-k

# --- Optional: needed only for gated HF models ---
# HUGGING_FACE_HUB_TOKEN=hf_xxx
